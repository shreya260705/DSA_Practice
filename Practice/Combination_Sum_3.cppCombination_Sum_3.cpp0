class Solution {
public:

    void combo( vector<vector<int>> & ans , vector<int> &curr , vector<int> &nums , int k , int n , int i , int currSum ){

        if( currSum == n && curr.size() == k ){

            ans.push_back(curr);
            return;
        }

        if( curr.size() > k ){

            return;
        }

        if( i >= 9 ){

            return;
        }

        if( currSum <= n ){

            curr.push_back(nums[i]);
             
               currSum += nums[i];

            combo( ans , curr , nums , k , n , i+1 , currSum ); 

            curr.pop_back();

               currSum -= nums[i];  

            combo( ans ,  curr ,  nums , k , n , i+1 , currSum ); 
   


        }

        else{

            return;
        }




    }
    vector<vector<int>> combinationSum3(int k, int n) {

        vector<int> nums = {1,2,3,4,5,6,7,8,9};
        vector<vector<int>> ans;
        vector<int> curr;
        int i = 0;
        int currSum = 0;

        combo( ans , curr , nums , k , n , i , currSum );

        return ans;
        
    }
};
